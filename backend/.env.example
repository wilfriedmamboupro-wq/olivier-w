## Copy this file to backend/.env and fill in your real values.
## backend/.env is gitignored -- it will never be committed.

# Required. Get one at console.anthropic.com (Settings -> API Keys -> Create Key).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional. Cheapest: claude-haiku-4-5 (default if omitted).
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional -- omit SMTP_USERNAME/SMTP_PASSWORD to run with mocked (console-logged) email sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Optional -- defaults to SMTP_USERNAME if omitted.
SMTP_FROM=you@gmail.com

# Optional. When set, EVERY outgoing email is redirected here instead (subject
# prefixed with the original intended recipient) -- handy so you always get
# the email without retyping your own address in the UI each time.
TEST_EMAIL_OVERRIDE=you@gmail.com

# Optional. Origins the FastAPI server accepts browser requests from.
CORS_ORIGIN_REGEX=http://localhost:\d+

# Optional but recommended. When set, every API route except /api/health
# requires this exact value in an X-API-Key header -- set the same value in
# frontend/.env.local (VITE_API_KEY). Leave both unset to run with no auth
# (fine for a throwaway local demo only).
API_KEY=choose-a-random-string

# Optional. Per-call timeout for Anthropic API requests, in seconds.
ANTHROPIC_TIMEOUT_SECONDS=30
